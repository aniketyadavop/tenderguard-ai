# ==============================================================================
# TenderGuard AI — Environment Configuration (.env.example)
# Government Procurement Vendor Document Verification & Compliance Platform
# ==============================================================================

# --- Application Metadata ---
PROJECT_NAME="TenderGuard AI"
PROJECT_DESCRIPTION="Explainable AI Framework for Vendor Compliance Verification in Government Procurement (GeM / CPPP)"
VERSION="4.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"  # Options: development, staging, production

# --- Database Configuration ---
# PostgreSQL Production Connection:
DATABASE_URL="postgresql://tenderguard:tenderguard_secret_2026@db:5432/tenderguard_db"
# Local SQLite Dev Alternative:
# DATABASE_URL="sqlite:///./tenderguard.db"

# --- Redis & Task Queue ---
REDIS_URL="redis://redis:6379/0"

# --- Security & Authentication (RBAC) ---
# Cryptographic secret key for signing short-lived JWT access tokens (Minimum 32 bytes)
SECRET_KEY="tenderguard-in-gov-procurement-secret-key-2026-change-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Short-lived access token validity (30 minutes)

# --- Cross-Origin Resource Sharing (CORS) ---
# JSON array of allowed origins for browser clients
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- Document Upload & Privacy Security ---
# Maximum file size per statutory GeM tender guidelines (25 MB in bytes)
MAX_UPLOAD_SIZE_BYTES=26214400
UPLOAD_STORAGE_DIR="./backend/uploads"
# Zero-Retention Mode: Ephemeral storage purged immediately post-evaluation (CWE-312 / MeitY Standard)
ZERO_RETENTION_MODE=true

# --- Frontend Client Configuration ---
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
